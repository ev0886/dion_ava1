# DION ABA1 runtime configuration for a clean Raspberry Pi OS install on Raspberry Pi 5.
# Install to /etc/default/dion_ava1 and then edit the stand-specific values below.
# This file is the runtime source of truth for dion-api.service.

# Safe runtime defaults
DION_APP_NAME=DION ABA1
DION_APP_ENVIRONMENT=production
DION_DATA_DIR=/opt/dion_ava1/var
DION_SQLITE_FILENAME=dion_aba1.sqlite3
DION_ALEMBIC_CONFIG_PATH=/opt/dion_ava1/alembic.ini
DION_API_HOST=127.0.0.1
DION_API_PORT=8000
DION_PYTHON_BIN=/opt/dion_ava1/.venv/bin/python

# Use "real" on the real stand after wiring verification.
DION_HARDWARE_PROVIDER=real

# Real hardware mapping:
# - verify the actual paths with: ls -l /dev/serial/by-path && readlink -f /dev/serial/by-path/*
# - drum and lock must use /dev/serial/by-path/... on the live stand
# - do not use ttyUSB0 or ttyUSB1 for drum or lock
# - on a cloned or newly wired stand, drum and lock may be swapped relative to the previous machine
# - RFID path still needs stand-specific verification and may remain an ACM device if that is what the hardware presents
DION_HARDWARE_REAL_ENDPOINTS='{"drum_controller":{"endpoint":{"code":"drum-1","driver_name":"drum-driver","enabled":true,"timeouts":{"connect_timeout_ms":1000,"read_timeout_ms":1000,"write_timeout_ms":1000}},"protocol":{"move_completion_timeout_ms":35000,"post_move_unlock_delay_ms":3000},"transport":{"transport":"serial","port":"/dev/serial/by-path/<replace-with-drum-controller-path>","baudrate":9600,"data_bits":8,"parity":"none","stop_bits":1}},"lock_controller":{"endpoint":{"code":"lock-1","driver_name":"lock-driver","enabled":true,"timeouts":{"connect_timeout_ms":1000,"read_timeout_ms":1000,"write_timeout_ms":1000}},"protocol":{"board_address":0},"transport":{"transport":"serial","port":"/dev/serial/by-path/<replace-with-lock-controller-path>","baudrate":19200,"data_bits":8,"parity":"none","stop_bits":1}},"rfid_reader":{"endpoint":{"code":"rfid-1","driver_name":"rfid-driver","enabled":true,"timeouts":{"connect_timeout_ms":1000,"read_timeout_ms":1000,"write_timeout_ms":1000}},"transport":{"transport":"serial","port":"/dev/ttyACM0","baudrate":9600,"data_bits":8,"parity":"none","stop_bits":1}}}'

# Current baseline admin access:
# - login: admin
# - default password reset behavior remains whatever the application currently implements
# Change the admin password in the admin UI on first use.
