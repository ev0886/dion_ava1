# Conservative local/dev defaults for DION ABA1.
# Copy to ".env" and adjust only the values you need.

DION_APP_NAME=DION ABA1
DION_APP_ENVIRONMENT=development

# Runtime storage and migrations
DION_DATA_DIR=var
DION_SQLITE_FILENAME=dion_aba1.sqlite3
DION_ALEMBIC_CONFIG_PATH=alembic.ini

# Supported values: mock, stub-real, real
DION_HARDWARE_PROVIDER=mock

# JSON object used by the real provider for ping-only boundary checks and future transport wiring.
# Keep empty for local/dev unless you are intentionally verifying real hardware endpoint availability.
# Expected top-level keys: drum_controller, lock_controller, rfid_reader
# Example:
# DION_HARDWARE_REAL_ENDPOINTS={"drum_controller":{"endpoint":{"code":"drum-1","driver_name":"drum-driver","enabled":true,"timeouts":{"connect_timeout_ms":1000,"read_timeout_ms":1000,"write_timeout_ms":1000}},"transport":{"transport":"serial","port":"/dev/ttyUSB0","baudrate":9600,"data_bits":8,"parity":"none","stop_bits":1}},"lock_controller":{"endpoint":{"code":"lock-1","driver_name":"lock-driver","enabled":true,"timeouts":{"connect_timeout_ms":1000,"read_timeout_ms":1000,"write_timeout_ms":1000}},"transport":{"transport":"tcp","host":"192.168.1.50","port":9001}},"rfid_reader":{"endpoint":{"code":"rfid-1","driver_name":"rfid-driver","enabled":true,"timeouts":{"connect_timeout_ms":1000,"read_timeout_ms":1000,"write_timeout_ms":1000}},"transport":{"transport":"serial","port":"/dev/ttyUSB1","baudrate":9600,"data_bits":8,"parity":"none","stop_bits":1}}}
DION_HARDWARE_REAL_ENDPOINTS={}

# API bind settings used by "python -m app.api" or the "dion-api" entry point.
DION_API_HOST=127.0.0.1
DION_API_PORT=8000
